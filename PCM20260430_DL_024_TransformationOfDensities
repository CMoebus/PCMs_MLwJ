###### 3.2 Examples for $g(X)$ and $g^{-1}(Y)$: the *Logistic Sigmoid* and the *Logit* Function

The *nonlinear* transformation of variables $X ≥ 0, Y \in [0, 1]$ are:

- *Logistic Sigmoid* (from $X \in \mathbb R^+$ to probabilities $Y \in \mathbb P$ )

$Y = g(X) := \frac{1}{1 + \exp(5 - X)},$

- *Logit* (= *log odds*) transformation of variables (from probabilities $Y \in \mathbb P$ to $x \in \mathbb R^+$ )

$X = g^{-1}(Y) := \ln\left(\frac{Y}{1 - Y}\right) + 5.$

"

# ╔═╡ f9157177-622f-4177-849d-db51c0a00c66
begin   # definition of constants
	const nSamples = 10^5
	const modeX    =  6.5
	const σX       =  1.0
	const Δx       =  0.1
	const Δy       =  0.01
	const xs       =  0.0:Δx:10.5
	const ys       =  0.0:Δy: 1.0
end # begin

# ╔═╡ 3eb00d2d-7186-4e08-adff-396bdae8fe7c
logisticSigmoid(x) = 1.0/(1.0 + exp(5.0 - x))   # definition of logistic sigmoid

# ╔═╡ 748ac0ff-0e85-4eb3-b4ff-628d651ca497
logit(y) = log(y/(1.0 - y)) + 5.0               # definition of logit function

# ╔═╡ fe9e36b9-0fbd-4c99-a16c-731e2569e849
g(x)     = logisticSigmoid(x)                   # definition of g(x)

# ╔═╡ 900bfc5c-7c6b-4fa6-be6f-63d2f8cc6e14
gInv(y)  = logit(y)                             # definition of g^{-1}(y)

# ╔═╡ d54853da-fff6-416a-bd5e-c78847e8e5ba
function plotSigmoidLogit()
	titlefontsize=9
	size=(600, 750)
	linewidth = 2
    #-------------------------------------------------------------------------------
	pl1 = 
		plot(size=size, title=L"Logistic\ sigmoid: Y = g(X) :=\frac{1}{1+exp(5-X)}", titlefontsize=titlefontsize, xs, g, color=:blueviolet, linewidth=linewidth, label=L"g(X)", xlabel=L"X", ylabel=L"Y (= p)")
	pl2 = 
		plot(size=size, title=L"Logit: X = g^{-1}(Y) := \ln\left(\frac{Y}{1-Y}\right) + 5", titlefontsize=titlefontsize, ys, gInv, color=:blueviolet, linewidth=linewidth, label=L"g^{-1}(Y)", xlabel=L"Y (= p)", ylabel=L"X")
	pl3 = 
		plot(size=size, title=L"X = g^{-1}(g(X))", titlefontsize=titlefontsize, 
		xs, gInv.(g.(xs)), color=:blueviolet, linewidth=linewidth, label=L"(X, X)", xlabel=L"X", ylabel=L"X")
	pl4 = 
		plot(size=size, title=L"Y = g(g^{-1}(Y))", titlefontsize=titlefontsize, 
		ys, g.(gInv.(ys)), color=:blueviolet, linewidth=linewidth, label=L"(Y, Y)", xlabel=L"Y", ylabel=L"Y")
    #-------------------------------------------------------------------------------
	plot(pl1, pl2, pl3, pl4, layout=(2,2))
end # function plotSigmoidLogit()

# ╔═╡ 263e6cd9-2b2c-4a20-9147-bf8d95b7a46f
plotSigmoidLogit()

