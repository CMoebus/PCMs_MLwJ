	plot!(xs, g, label=L"Logistic\ Sigmoid\ g(X)", linewidth=linewidth, color=:blueviolet, xlabel=L"X", ylabel=L"Y\ \ (=P)")
	annotate!(8.8, 1.02, text(L"g(X)=Logistic\ Sigmoid", annotateFontSize))
	annotate!(2.2, 0.10, text(L"g(X)", annotateFontSize))
	#------------------------------------------------------------------------------
	# histogram of N(x; μ_x=modeX=6.5, σ_x=1)
